@@ -0,0 +1,71 @@
+/// <reference types="node" />
+import process from 'node:process'
+import { describe, it, expect } from 'vitest'
+import { HonkClient } from './client'
+import { readGroupEntries, writeGroupEntry, noNodes } from './dae/groups'
+
+describe('honk group editing', () => {
+  it('preserves other fields and comments when selecting score', () => {
+    const before = 'group {\n proxy {\n # retain\n filter: subtag(airport)\n policy: min\n final: direct\n }\n}\n'
+    const next = writeGroupEntry(before, 'proxy', { filters: ['subtag(airport)'], policy: 'score' })
+    expect(next).toContain('# retain'); expect(next).toContain('final: direct')
+    expect(readGroupEntries(next)[0].policy).toBe('score')
+  })
+  it('writes an explicitly empty group instead of selecting all nodes', () => {
+    expect(readGroupEntries(writeGroupEntry('', 'empty', {filters: [noNodes], policy: 'score'}))[0].filters).toEqual([noNodes])
+  })
+})
+
+const integration = Boolean(process.env.HONK_TEST_ENDPOINT && process.env.HONK_TEST_USERNAME && process.env.HONK_TEST_PASSWORD)
+describe.skipIf(!integration)('real honk beta.6 native API (mock eBPF)', () => {
+  it('logs in, edits existing groups, imports a node, changes membership, rejects stale writes and persists score', async () => {
+    const endpoint = process.env.HONK_TEST_ENDPOINT!
+    const auth = await HonkClient.login(endpoint, process.env.HONK_TEST_USERNAME!, process.env.HONK_TEST_PASSWORD!)
+    const client = new HonkClient(endpoint, auth.token)
+    const call = (name: string, variables = {}) => client.request<any>(`mutation ${name} { ignored }`, variables)
+    const previous = await client.snapshot()
+    for (const g of previous.groups.filter(g => g.name === 'test_group')) await call('RemoveGroup',{id:g.id})
+    for (const p of previous.providers.filter(p => p.name === 'fixture_airport')) await call('RemoveSubscriptions',{ids:[p.id]})
+    for (const n of previous.nodes.filter(n => n.name === 'test_node')) await call('RemoveNodes',{ids:[n.id]})
+    const before = await client.snapshot()
+    expect(before.nodes.some(n => n.name === 'fixture')).toBe(true)
+    const created = await call('CreateGroup', {name:'test_group',policy:'score'})
+    let id = created.createGroup.id
+    expect(id).toBeTruthy()
+    await call('ImportNodes', {args:[{tag:'test_node',link:'socks5://127.0.0.1:19081#test_node'}]})
+    const n = (await client.snapshot()).nodes.find(n => n.name === 'test_node')!
+    expect(n).toBeTruthy()
+    await call('GroupAddNodes',{id,nodeIDs:[n.id]})
+    const groups = await call('Groups')
+    expect(groups.groups.find((g:any) => g.id === id).nodes.map((n:any)=>n.name)).toContain('test_node')
+    await call('GroupSetPolicy',{id,policy:'min'})
+    await call('GroupSetPolicy',{id,policy:'score'})
+    await call('RenameGroup',{id,name:'test_group_renamed'})
+    id = (await client.snapshot()).groups.find(g=>g.name==='test_group_renamed')!.id
+    await call('RenameGroup',{id,name:'test_group'})
+    id = (await client.snapshot()).groups.find(g=>g.name==='test_group')!.id
+    if (process.env.HONK_TEST_SUB_URL) {
+      await call('ImportSubscription',{arg:{tag:'fixture_airport',link:process.env.HONK_TEST_SUB_URL}})
+      const provider = (await client.snapshot()).providers.find(p => p.name === 'fixture_airport')!
+      expect(provider).toBeTruthy()
+      await call('GroupAddSubscriptions',{id,subscriptionIDs:[provider.id]})
+      const subscribed = (await call('Groups')).groups.find((g:any)=>g.id===id)
+      expect(subscribed.subscriptions[0].matchedNodes.length).toBeGreaterThan(0)
+      await call('GroupAddSubscriptions',{id,subscriptionIDs:[provider.id],nameFilterRegex:'sub_.*'})
+      expect((await call('Groups')).groups.find((g:any)=>g.id===id).subscriptions[0].nameFilterRegex).toBe('sub_.*')
+      await call('UpdateSubscriptionCron',{id:provider.id,cronEnable:true,cronExp:'3600'})
+      expect((await call('Subscriptions')).subscriptions.find((p:any)=>p.id===provider.id).cronEnable).toBe(true)
+      await call('GroupDelSubscriptions',{id,subscriptionIDs:[provider.id]})
+      await call('RemoveSubscriptions',{ids:[provider.id]})
+    }
+    const stale = (await client.snapshot()).sources.find(s => s.kind === 'main')!
+    await client.save(stale, stale.content + '\n# native editor write\n')
+    await expect(client.save(stale, stale.content + '\n# stale write\n')).rejects.toThrow()
+    expect((await client.snapshot()).groups.find(g=>g.id === id)?.policy.kind).toBe('score')
+    await call('GroupDelNodes',{id,nodeIDs:[n.id]})
+    expect((await call('Groups')).groups.find((g:any)=>g.id===id).nodes).toEqual([])
+    await call('RemoveGroup',{id})
+    await call('RemoveNodes',{ids:[n.id]})
+    await expect(call('CreateGroup',{name:'bad_policy',policy:'random'})).rejects.toThrow()
+  }, 90000)
+})
diff --git a/apps/web/src/honk/client.ts b/apps/web/src/honk/client.ts
new file mode 100644
index 0000000000000000000000000000000000000000..77d032fe192aca6ad1d193194b19437bc93d72da
--- /dev/null
+++ b/apps/web/src/honk/client.ts
@@ -0,0 +1,250 @@
+import {renameReference, subscriptionBinding} from './edits'
+import type { RequestDocument, Variables } from 'graphql-request'
+import type { GQLClientInterface } from '~/contexts'
+import { readGroupEntries, writeGroupEntry, noNodes } from './dae/groups'
+import { readNodeEntries, writeNodeEntry } from './dae/nodes'
+import { readSubscriptionEntries, writeSubscriptionEntry } from './dae/subscriptions'
+import { quote, scanConfig } from './dae/text'
+
+export const HONK = import.meta.env.VITE_HONK === '1'
+export interface Source { id: string; path: string; kind: string; content: string; content_sha256: string; writable: boolean }
+interface Node { id: string; name: string; protocol: string | null; provider_id?: string | null; health: Array<{ transport: string; latency_ms?: number; observed_at?: string; state?: string; purpose?: string; measurement?: string }> }
+interface Provider { id: string; name: string; kind: string; url_redacted: string; status: string; updated_at: string | null }
+interface Group { id: string; name: string; policy: { kind: string; native: string }; config_revision: string }
+interface Snapshot { sources: Source[]; nodes: Node[]; providers: Provider[]; groups: Group[] }
+type Args = Record<string, any>
+const enc = encodeURIComponent
+const name = (value: string) => {
+  if (!/^[\w.-]+$/.test(value)) throw new Error('群组名称仅支持字母、数字、下划线、点和短横线')
+  return value
+}
+function operation(document: RequestDocument) {
+  if (typeof document === 'string' || document instanceof String) return /(?:query|mutation)\s+(\w+)/.exec(String(document))?.[1] ?? ''
+  return (document.definitions.find(d => d.kind === 'OperationDefinition') as { name?: { value: string } })?.name?.value ?? ''
+}
+
+// The existing daed components keep their request interface. This client talks
+// exclusively to honk's native API; no GraphQL server or dae-wing runs here.
+export class HonkClient implements GQLClientInterface {
+  private writes: Promise<unknown> = Promise.resolve()
+  constructor(readonly endpoint: string, readonly token: string) {}
+  static async login(endpoint: string, username: string, password: string) {
+    const client = new HonkClient(endpoint, '')
+    return client.api<{token: string}>('/auth/login', 'POST', {username, password})
+  }
+  private url(path: string) {
+    return this.endpoint.includes('cgi-bin/') ? `${this.endpoint}?path=${encodeURIComponent('/api/v1' + path)}` : this.endpoint.replace(/\/$/, '') + path
+  }
+  async api<T = any>(path: string, method = 'GET', body?: unknown, headers: Record<string, string> = {}): Promise<T> {
+    const response = await fetch(this.url(path), {
+      method, headers: { ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}), ...(body === undefined ? {} : { 'Content-Type': 'application/json' }), ...headers },
+      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+    })
+    const data = response.status === 204 ? null : await response.json()
+    if (!response.ok) throw new Error(data.error?.message ?? data.message ?? `honk HTTP ${response.status}`)
+    return data
+  }
+  async wait(result: any): Promise<any> {
+    if (!result?.operation_id) return result
+    for (let i = 0; i < 60; i++) {
+      const op = await this.api(`/operations/${enc(result.operation_id)}`)
+      if (op.status === 'succeeded') return op.result
+      if (op.status === 'failed') throw new Error(op.error?.message ?? 'honk 激活配置失败，请检查日志')
+      await new Promise(resolve => setTimeout(resolve, 1000))
+    }
+    throw new Error('honk 操作仍未完成，请刷新确认；未报告成功')
+  }
+  async list(path: string, key: string) {
+    const all: any[] = []
+    let cursor: string | null = null
+    do {
+      const page: any = await this.api(path + (cursor ? `?cursor=${enc(cursor)}` : ''))
+      all.push(...page[key]); cursor = page.next_cursor
+    } while (cursor)
+    return all
+  }
+  async snapshot(): Promise<Snapshot> {
+    const [config, nodes, providers, groups] = await Promise.all([
+      this.api('/config'), this.list('/nodes', 'nodes'), this.list('/providers', 'providers'), this.api('/groups'),
+    ])
+    return { sources: config.sources, nodes: nodes.filter(n => n.protocol !== 'direct' && n.protocol !== 'block'), providers, groups }
+  }
+  async save(source: Source, content: string) {
+    if (!source.writable) throw new Error('此配置源只读，请将监听器凭据放入独立 include 文件')
+    if (content === source.content) return
+    await this.wait(await this.api(`/config/sources/${enc(source.id)}`, 'PUT', { content }, { 'If-Match': `"${source.content_sha256}"` }))
+  }
+  private source(s: Snapshot, predicate: (text: string) => boolean): Source {
+    const found = s.sources.filter(x => ['main', 'include'].includes(x.kind) && predicate(x.content))
+    if (found.length !== 1) throw new Error('无法唯一定位配置项，请在配置源编辑器中修改')
+    if (!found[0].writable) throw new Error('配置源只读')
+    return found[0]
+  }
+  private node(s: Snapshot, id: string) {
+    const n = s.nodes.find(x => x.id === id)
+    if (!n) throw new Error('节点已变化，请刷新')
+    return n
+  }
+  private viewNode(s: Snapshot, n: Node) {
+    const candidates = s.sources.flatMap(x => readNodeEntries(x.content)).filter(x => x.name === n.name)
+    return { id: n.id, name: n.name, protocol: n.protocol ?? '', link: candidates.length === 1 ? candidates[0].link : '', address: '', tag: n.name, subscriptionID: n.provider_id && n.provider_id !== 'inline' ? n.provider_id : null }
+  }
+  private viewProvider(s: Snapshot, p: Provider) {
+    const authored = s.sources.flatMap(x => readSubscriptionEntries(x.content)).find(x => x.tag === p.name)
+    return { id: p.id, tag: p.name, link: p.url_redacted ?? '', status: p.status, info: null, updatedAt: p.updated_at ?? '', cronExp: String(authored?.interval || 3600), cronEnable: !!authored?.interval,
+      nodes: { edges: s.nodes.filter(n => n.provider_id === p.id).map(n => this.viewNode(s, n)) } }
+  }
+  private async groups(s: Snapshot) {
+    return Promise.all(s.groups.map(async g => {
+      const full = await this.api(`/groups/${enc(g.id)}`)
+      const entry = s.sources.flatMap(x => readGroupEntries(x.content)).find(x => x.name === g.name)
+      const bindings = (entry?.filters ?? []).map(subscriptionBinding).filter(x => x !== null)
+      const subtags = bindings.flatMap(x => x.tags)
+      const members = new Set(full.members.map((x: { id: string }) => x.id))
+      const providers = s.providers.filter(p => subtags.includes(p.name))
+      const native = g.policy.native
+      return { id: g.id, name: g.name, policy: native.replace(/\(.*$/, ''), policyParams: native.startsWith('fixed(') ? [{ key: '', val: native.slice(6, -1) }] : [],
+        nodes: s.nodes.filter(n => members.has(n.id) && !providers.some(p => p.id === n.provider_id)).map(n => this.viewNode(s, n)),
+        subscriptions: providers.map(p => ({ subscription: this.viewProvider(s, p), nameFilterRegex: bindings.find(x => x.tags.includes(p.name))?.regex ?? '', matchedCount: s.nodes.filter(n => n.provider_id === p.id && members.has(n.id)).length,
+          matchedNodes: s.nodes.filter(n => n.provider_id === p.id && members.has(n.id)).map(n => this.viewNode(s, n)) })) }
+    }))
+  }
+  request = async <T, V extends Variables = Variables>(document: RequestDocument, variables?: V): Promise<T> => {
+    const op = operation(document)
+    const reads = ['Groups', 'Nodes', 'Subscriptions', 'Configs', 'NodeLatencies']
+    if (reads.includes(op)) return this.execute(op, variables ?? {}) as Promise<T>
+    // Serialize writes from bulk imports so one browser never races its own ETags.
+    const result = this.writes.then(() => this.execute(op, variables ?? {}))
+    this.writes = result.catch(() => {})
+    return result as Promise<T>
+  }
+  private async execute(op: string, v: Args): Promise<unknown> {
+    if (op === 'Configs') return { configs: [] }
+    if (op === 'Run') { await this.wait(await this.api('/operations/reload', 'POST', {})); return { run: true } }
+    const s = await this.snapshot()
+    if (op === 'Nodes') return { nodes: { edges: s.nodes.filter(n => (!n.provider_id || n.provider_id === 'inline')).map(n => this.viewNode(s, n)) } }
+    if (op === 'Subscriptions') return { subscriptions: s.providers.filter(p => p.kind === 'subscription').map(p => this.viewProvider(s, p)) }
+    if (op === 'Groups') return { groups: await this.groups(s) }
+    if (op === 'NodeLatencies') return { nodeLatencies: s.nodes.map(n => {
+      const h = n.health.filter(x => x.transport === 'tcp' && x.purpose === 'data').sort((a, b) => String(b.observed_at).localeCompare(String(a.observed_at)))[0]
+      return { id: n.id, latencyMs: h?.latency_ms ?? null, alive: !h || h.state === 'unknown' ? null : h.state === 'healthy', testedAt: h?.observed_at ?? null, message: null }
+    }) }
+    if (op === 'TestNodeLatencies') {
+      const selected = v.ids ? s.nodes.filter(n => v.ids.includes(n.id)) : s.nodes
+      for (const n of selected) await this.wait(await this.api('/probes', 'POST', {
+        target: {type: 'node', node_id: n.id}, kind: 'http', transport: ['tcp'], ip_version: 'any', warmth: 'cold',
+      }))
+      const result = await this.execute('NodeLatencies', {}) as {nodeLatencies: unknown[]}
+      return {testNodeLatencies: result.nodeLatencies}
+    }
+    if (op === 'ImportNodes') {
+      const results = []
+      for (const arg of v.args) {
+        try {
+          let suffix = ''; try { suffix = decodeURIComponent(arg.link.split('#')[1] ?? '') } catch {}
+          const nodeName = arg.tag || suffix || `node-${Date.now().toString(36) + Math.random().toString(36).slice(2, 6)}`
+          const result = await this.wait(await this.api('/nodes', 'POST', { name: nodeName, link: arg.link }))
+          results.push({ link: arg.link, error: null, node: { id: result?.node?.id ?? result?.id ?? nodeName } })
+        } catch (e) { results.push({ link: arg.link, error: (e as Error).message, node: null }) }
+      }
+      return { importNodes: results }
+    }
+    if (op === 'RemoveNodes' || op === 'RemoveSubscriptions') {
+      for (const id of v.ids) await this.wait(await this.api(`/${op === 'RemoveNodes' ? 'nodes' : 'providers'}/${enc(id)}`, 'DELETE'))
+      return { [op === 'RemoveNodes' ? 'removeNodes' : 'removeSubscriptions']: true }
+    }
+    if (op === 'ImportSubscription') {
+      await this.wait(await this.api('/providers', 'POST', { name: v.arg.tag || new URL(v.arg.link).hostname, kind: 'subscription', url: v.arg.link }))
+      const fresh = await this.snapshot()
+      const provider = fresh.providers.find(x => x.name === (v.arg.tag || new URL(v.arg.link).hostname))
+      if (!provider) throw new Error('订阅创建后未出现在 honk 中')
+      await this.wait(await this.api(`/providers/${enc(provider.id)}/refresh`, 'POST'))
+      return { importSubscription: { link: v.arg.link, sub: { id: provider.id }, nodeImportResult: [] } }
+    }
+    if (op === 'UpdateSubscription') {
+      await this.wait(await this.api(`/providers/${enc(v.id)}/refresh`, 'POST'))
+      return { updateSubscription: { id: v.id } }
+    }
+    if (op === 'UpdateNode' || op === 'TagNode') {
+      const n = this.node(s, v.id)
+      if (n.provider_id && n.provider_id !== 'inline') throw new Error('订阅节点由订阅管理，不能单独修改')
+      const source = this.source(s, t => readNodeEntries(t).some(x => x.name === n.name))
+      const entry = readNodeEntries(source.content).find(x => x.name === n.name)!
+      await this.save(source, writeNodeEntry(source.content, entry, { name: op === 'TagNode' ? v.tag : n.name, link: v.newLink ?? entry.link }))
+      return { updateNode: { ...this.viewNode(s, n), link: v.newLink ?? entry.link }, tagNode: true }
+    }
+    if (op === 'TagSubscription' || op === 'UpdateSubscriptionLink' || op === 'UpdateSubscriptionCron') {
+      const p = s.providers.find(x => x.id === v.id)
+      if (!p) throw new Error('订阅已变化，请刷新')
+      const source = this.source(s, t => readSubscriptionEntries(t).some(x => x.tag === p.name))
+      if (op === 'UpdateSubscriptionCron' && v.cronEnable && !/^[1-9][0-9]*$/.test(v.cronExp)) throw new Error('更新间隔必须是正整数秒')
+      let content = writeSubscriptionEntry(source.content, p.name, op === 'TagSubscription' ? { tag: v.tag } : op === 'UpdateSubscriptionCron' ? {interval: v.cronEnable ? Number(v.cronExp) : 0} : { url: v.link })
+      if (op === 'TagSubscription') {
+        if (s.sources.some(x => x.id !== source.id && renameReference(x.content,p.name,v.tag,'subtag') !== x.content)) throw new Error('订阅被其他配置文件引用，请先在配置源中调整引用')
+        content = renameReference(content,p.name,v.tag,'subtag')
+      }
+      await this.save(source, content)
+      return { tagSubscription: true, updateSubscriptionLink: true, updateSubscriptionCron: true }
+    }
+    if (op === 'CreateGroup') {
+      name(v.name)
+      if (s.groups.some(g => g.name === v.name)) throw new Error('群组名称已存在')
+      const source = s.sources.find(x => x.kind === 'main' && x.writable)
+      if (!source) throw new Error('主配置不可写，请先分离监听器凭据')
+      await this.save(source, writeGroupEntry(source.content, v.name, { filters: [noNodes], policy: this.policy(v) }))
+      return { createGroup: { id: (await this.snapshot()).groups.find(g => g.name === v.name)?.id } }
+    }
+    if (op.startsWith('Group') || op === 'RemoveGroup' || op === 'RenameGroup') {
+      const g = s.groups.find(x => x.id === v.id)
+      if (!g) throw new Error('群组已变化，请刷新')
+      const source = this.source(s, t => readGroupEntries(t).some(x => x.name === g.name))
+      const entry = readGroupEntries(source.content).find(x => x.name === g.name)!
+      let content = source.content
+      if (op === 'GroupSetPolicy') content = writeGroupEntry(content, g.name, { filters: entry.filters, policy: this.policy(v) })
+      else if (op === 'RemoveGroup') {
+        const block = scanConfig(content).blocks.filter(b => b.name === 'group').flatMap(b => b.children).find(b => b.name === g.name)!
+        content = content.slice(0, block.from) + content.slice(block.to)
+      } else if (op === 'RenameGroup') {
+        name(v.name)
+        if (s.groups.some(x => x.name === v.name && x.id !== g.id)) throw new Error('群组名称已存在')
+        if (s.sources.some(x => x.id !== source.id && renameReference(x.content,g.name,v.name,'group') !== x.content)) throw new Error('此群组被其他配置文件引用，请先在配置源中调整引用')
+        content = renameReference(content,g.name,v.name,'group')
+      } else {
+        let filters = entry.filters.length ? entry.filters.filter(f => f !== noNodes) : ["name(regex: '.*')"]
+        const add = op === 'GroupAddNodes' || op === 'GroupAddSubscriptions'
+        const nodeOp = op === 'GroupAddNodes' || op === 'GroupDelNodes'
+        if (!nodeOp && !['GroupAddSubscriptions', 'GroupDelSubscriptions'].includes(op)) throw new Error(`不支持 ${op}`)
+        if (v.nameFilterRegex) quote(v.nameFilterRegex)
+        const values = nodeOp ? v.nodeIDs.map((id: string) => this.node(s, id).name) : v.subscriptionIDs.map((id: string) => {
+          const p = s.providers.find(x => x.id === id); if (!p) throw new Error('订阅不存在'); return p.name
+        })
+        const call = nodeOp ? 'name' : 'subtag'
+        for (const value of values) {
+          const filter = `${call}(${quote(value)})` + (!nodeOp && v.nameFilterRegex ? ` && name(regex: ${quote(v.nameFilterRegex)})` : '')
+          if (add) {
+            if (!nodeOp) filters = filters.filter(f => !subscriptionBinding(f)?.tags.includes(value))
+            if (!filters.includes(filter)) filters.push(filter)
+          }
+          else {
+            if (!nodeOp && filters.some(f => subscriptionBinding(f)?.tags.length === 1 && subscriptionBinding(f)?.tags[0] === value)) {
+              filters = filters.filter(f => subscriptionBinding(f)?.tags[0] !== value); continue
+            }
+            if (!filters.includes(filter)) throw new Error('该节点由复合筛选或全选规则加入，请在配置源中修改筛选')
+            filters = filters.filter(f => f !== filter)
+          }
+        }
+        content = writeGroupEntry(content, g.name, { filters: filters.length ? filters : [noNodes], policy: entry.policy })
+      }
+      await this.save(source, content)
+      return { [op[0].toLowerCase() + op.slice(1)]: true }
+    }
+    throw new Error(`honk 不支持此 daed 操作：${op}。配置可在上方配置源中编辑。`)
+  }
+  private policy(v: Args) {
+    if (!['score', 'min', 'min_avg10', 'min_moving_avg', 'min_last_delay', 'fixed'].includes(v.policy)) throw new Error('honk 不支持此策略')
+    if (v.policy !== 'fixed') return v.policy
+    const index = v.policyParams?.[0]?.val ?? '0'
+    if (!/^\d+$/.test(index)) throw new Error('固定节点序号必须是非负整数')
+    return `fixed(${index})`
+  }
+}
