+import {scanConfig, unquote, quote} from './dae/text'
+import {exactTokens, splitTop} from './dae/groups'
+
+export function subscriptionBinding(filter: string) {
+  const parts = splitTop(filter, '&&').map(s => s.trim())
+  const tags = exactTokens(parts[0], 'subtag')?.map(unquote)
+  if (!tags) return null
+  const regex = parts.length === 2 ? /^name\(\s*regex:\s*(['"])(.*)\1\s*\)$/.exec(parts[1])?.[2] : ''
+  if (regex === undefined || parts.length > 2) return null
+  return {tags, regex}
+}
+
+export function renameReference(text: string, oldName: string, next: string, kind: 'group' | 'subtag') {
+  const {tokens, blocks} = scanConfig(text)
+  const edits: Array<{from:number;to:number;text:string}> = []
+  const raw = (i:number) => i < 0 ? '' : text.slice(tokens[i]?.from, tokens[i]?.to)
+  let call = ''
+  for (let i = 0; i < tokens.length; i++) {
+    const t = tokens[i]
+    if (t.kind === 'comment') continue
+    if (raw(i) === '(' && t.parens === 0) call = raw(i-1)
+    if (raw(i) === ')' && t.parens === 1) call = ''
+    if (unquote(raw(i)) !== oldName) continue
+    const argument = call === kind && t.parens === 1 && raw(i-1) !== ':' && raw(i+1) !== ':'
+    const outbound = kind === 'group' && (raw(i-1) === '->' || (raw(i-1) === ':' && ['fallback','default','final','route','download_detour'].includes(raw(i-2))))
+    const header = kind === 'group' && blocks.filter(b=>b.name==='group').flatMap(b=>b.children).some(b=>b.from===t.from)
+    if (argument || outbound || header) edits.push({from:t.from,to:t.to,text:kind === 'group' && /^[\w.-]+$/.test(next) ? next : quote(next)})
+  }
+  return edits.reverse().reduce((out,e)=>out.slice(0,e.from)+e.text+out.slice(e.to),text)
+}
diff --git a/apps/web/src/honk/shell.tsx b/apps/web/src/honk/shell.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..110895845eb5e3843a51b5f40e269a8dd046da2a
--- /dev/null
+++ b/apps/web/src/honk/shell.tsx
@@ -0,0 +1,93 @@
+import { useStore } from '@nanostores/react'
+import { useQuery, useQueryClient } from '@tanstack/react-query'
+import { useEffect, useState } from 'react'
+import { Navigate, Outlet, useNavigate } from 'react-router-dom'
+import { toast } from 'sonner'
+import { Button } from '~/components/ui/button'
+import { Input } from '~/components/ui/input'
+import { useColorScheme, useGQLQueryClient } from '~/contexts'
+import { endpointURLAtom, tokenAtom } from '~/store'
+import { HonkClient, type Source } from './client'
+
+export function HonkSetup() {
+  const navigate = useNavigate()
+  const [endpoint, setEndpoint] = useState(endpointURLAtom.get())
+  const [username, setUsername] = useState('admin')
+  const [password, setPassword] = useState('')
+  const [busy, setBusy] = useState(false)
+  async function login(e: React.FormEvent) {
+    e.preventDefault(); setBusy(true)
+    try {
+      const url = new URL(endpoint, location.href)
+      if (!['http:', 'https:'].includes(url.protocol)) throw new Error('请输入 HTTP(S) API 地址')
+      const session = await HonkClient.login(endpoint, username, password)
+      const client = new HonkClient(endpoint, session.token)
+      const version = await client.api('/version')
+      if (version.engine?.name !== 'honk') throw new Error('此地址不是 honk Native API')
+      await client.api('/config')
+      endpointURLAtom.set(endpoint.replace(/\/$/, '')); tokenAtom.set(session.token)
+      navigate('/')
+    } catch (e) { toast.error((e as Error).message) } finally { setBusy(false) }
+  }
+  return <main className="min-h-screen bg-pattern flex items-center justify-center p-6">
+    <form className="bg-card border rounded-xl p-8 space-y-5 w-full max-w-md" onSubmit={login}>
+      <h1 className="text-2xl font-semibold">daede · honk</h1>
+      <p className="text-sm text-muted-foreground">使用 LuCI 配置页设置的 honk 面板账号密码登录。</p>
+      <Input label="Native API" value={endpoint} onChange={e => setEndpoint(e.target.value)} required />
+      <Input label="账号" value={username} onChange={e => setUsername(e.target.value)} required />
+      <Input label="密码" type="password" value={password} onChange={e => setPassword(e.target.value)} required />
+      <Button disabled={busy} type="submit">{busy ? '连接中…' : '连接 honk'}</Button>
+    </form>
+  </main>
+}
+
+export function HonkLayout() {
+  const token = useStore(tokenAtom)
+  const client = useGQLQueryClient() as HonkClient
+  const queries = useQueryClient()
+  const { themeMode, setThemeMode } = useColorScheme()
+  const [busy, setBusy] = useState(false)
+  const health = useQuery({ queryKey: ['honk-runtime'], queryFn: () => client.api('/runtime'), enabled: !!token, retry: false, refetchInterval: 5000 })
+  if (!token) return <Navigate to="/setup" replace />
+  return <div className="min-h-screen bg-pattern">
+    <header className="border-b bg-card/80 px-6 py-4 flex flex-wrap items-center gap-4">
+      <h1 className="text-xl font-semibold mr-auto">daede · honk</h1>
+      <span className="text-sm">{health.error ? '连接失败' : health.data ? '已连接 honk' : '连接中…'}</span>
+      <Button variant="outline" onClick={() => setThemeMode(themeMode === 'dark' ? 'light' : 'dark')}>切换主题</Button>
+      <Button disabled={busy} onClick={async () => {
+        setBusy(true)
+        try { await client.wait(await client.api('/operations/reload', 'POST', {})); await queries.invalidateQueries(); toast.success('honk 已重载') }
+        catch (e) { toast.error((e as Error).message) } finally { setBusy(false) }
+      }}>重载配置</Button>
+      <Button variant="outline" onClick={async () => { try { await client.api('/auth/logout', 'POST') } finally { tokenAtom.set('') } }}>退出</Button>
+    </header>
+    <main className="container mx-auto max-w-7xl p-6">
+      {health.error ? <p role="alert">{health.error.message}</p> : health.data ? <Outlet /> : null}
+    </main>
+    <footer className="text-center text-xs text-muted-foreground p-6">daed WebUI · daeuniverse · honk 适配 · 配置文本工具来自 doona (GPL-3.0)</footer>
+  </div>
+}
+
+export function HonkSources() {
+  const client = useGQLQueryClient() as HonkClient
+  const queries = useQueryClient()
+  const { data, error } = useQuery({ queryKey: ['honk-sources'], queryFn: () => client.api<{ sources: Source[] }>('/config') })
+  const [editing, setEditing] = useState<Source | null>(null)
+  const [content, setContent] = useState('')
+  const [busy, setBusy] = useState(false)
+  useEffect(() => { if (error) toast.error(error.message) }, [error])
+  return <details className="rounded-xl border bg-card p-4">
+    <summary className="cursor-pointer font-medium">honk 配置源 · 全局设置、DNS 与路由</summary>
+    <p className="text-sm text-muted-foreground my-3">节点、订阅和群组可在下方管理，保存后即由 honk 校验并生效。其他设置在此编辑；只读的监听器配置不会被覆盖。</p>
+    <div className="flex flex-wrap gap-2 mb-3">{data?.sources.filter(s => s.writable && !s.content.includes('native_api')).map(s => <Button key={s.id} variant="outline" onClick={() => { setEditing(s); setContent(s.content) }}>{s.path}</Button>)}</div>
+    {editing && <div className="space-y-3">
+      <textarea aria-label="honk 配置源码" className="w-full min-h-80 rounded border p-3 font-mono text-sm bg-background" value={content} onChange={e => setContent(e.target.value)} />
+      <Button disabled={busy} onClick={async () => {
+        setBusy(true)
+        try { await client.save(editing, content); setEditing(null); await queries.invalidateQueries(); toast.success('配置已通过校验并生效') }
+        catch (e) { toast.error((e as Error).message) } finally { setBusy(false) }
+      }}>保存并应用</Button>
+      <Button variant="outline" onClick={() => setEditing(null)}>取消</Button>
+    </div>}
+  </details>
+}
