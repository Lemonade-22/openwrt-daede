new file mode 100644
index 0000000..f301ed3
--- /dev/null
+++ b/luci-app-daede/root/usr/share/luci-app-daede/honk-config.sh
@@ -0,0 +1,100 @@
+#!/bin/sh
+# honk integration for the LuCI group form. Requires the upstream honk package
+# with native-api support. Its init script and binaries remain package-owned.
+set -eu
+umask 077
+
+CONFIG=/etc/honk/daede.dae
+SECRET=/etc/honk/daede.secret
+API=http://127.0.0.1:9528/api/v1
+WORK=""
+fail() { echo "$*" >&2; exit 1; }
+cleanup() { [ -z "$WORK" ] || rm -rf "$WORK"; }
+trap cleanup EXIT
+trap 'exit 1' HUP INT TERM
+
+request() {
+	method="$1"; endpoint="$2"; body="${3:-}"
+	if [ -n "$body" ]; then
+		curl -fsS --noproxy '*' --connect-timeout 2 --max-time 10 \
+			-H "@$WORK/headers" -H 'Content-Type: application/json' \
+			-X "$method" --data-binary "@$body" "$API$endpoint" > "$WORK/response"
+	else
+		curl -fsS --noproxy '*' --connect-timeout 2 --max-time 10 \
+			-H "@$WORK/headers" -X "$method" "$API$endpoint" > "$WORK/response"
+	fi
+}
+field() {
+	ucode -e 'let fs=require("fs"); let v=json(fs.readfile(ARGV[0])); print(v[ARGV[1]] ?? "");' -- "$WORK/response" "$1"
+}
+
+case "${1:-}" in
+defaults)
+	exec /usr/share/luci-app-daede/config-defaults.sh
+	;;
+listener)
+	mkdir -p /etc/honk
+	if [ ! -s "$SECRET" ]; then
+		cat /proc/sys/kernel/random/uuid /proc/sys/kernel/random/uuid | tr -d '\n-' > "$SECRET"
+	fi
+	chmod 600 "$SECRET"
+	token="$(cat "$SECRET")"
+	case "$token" in ''|*[!0-9a-f]*) fail 'invalid honk management token' ;; esac
+	cat <<EOF
+experimental {
+    native_api {
+        enabled: true
+        listen: '127.0.0.1:9528'
+        secret: '$token'
+        config_write: true
+    }
+}
+EOF
+	;;
+install)
+	candidate="${2:-}"
+	case "$candidate" in /tmp/honk-gen.*) ;; *) fail 'invalid generated honk config path' ;; esac
+	[ -f "$candidate" ] || fail 'generated honk config is missing'
+	[ -x /etc/init.d/honk ] && [ -x /usr/bin/honk-core ] || fail 'install the upstream honk OpenWrt package first'
+	[ "$(uci -q get honk.config.store || echo file)" != db ] || fail 'honk is using database storage; this LuCI form requires file storage'
+	running=0
+	if pidof honk-core >/dev/null 2>&1; then
+		running=1
+		[ "$(uci -q get honk.config.config_file || :)" = "$CONFIG" ] || fail 'stop honk before saving this form for the first time'
+	fi
+	WORK="$(mktemp -d /tmp/daede-honk.XXXXXX)"
+	printf 'Authorization: Bearer %s\n' "$(cat "$SECRET")" > "$WORK/headers"
+	if [ "$running" = 1 ]; then
+		ucode -e 'let fs=require("fs"); print({mode:"full",sources:[{path:ARGV[1],content:fs.readfile(ARGV[0])}]});' \
+			-- "$candidate" "$CONFIG" > "$WORK/validate.json"
+		request POST /config/validate "$WORK/validate.json" || fail 'cannot validate the honk configuration'
+		[ "$(field valid)" = true ] || fail 'honk rejected the generated configuration; the active file was kept'
+	fi
+	# A stopped engine admits the file at startup; a running engine validates it
+	# before replacement and acknowledges the actual reload operation below.
+	cp "$candidate" "$CONFIG.tmp"
+	chmod 600 "$CONFIG.tmp"
+	mv "$CONFIG.tmp" "$CONFIG"
+	uci set "honk.config.config_file=$CONFIG"
+	uci commit honk
+	if [ "$running" = 1 ]; then
+		printf '{}' > "$WORK/reload.json"
+		request POST /operations/reload "$WORK/reload.json" || fail 'honk reload request failed; generated config is saved on disk'
+		operation="$(field operation_id)"
+		case "$operation" in ''|*[!A-Za-z0-9_-]*) fail 'invalid honk reload operation' ;; esac
+		attempt=0
+		while [ "$attempt" -lt 20 ]; do
+			request GET "/operations/$operation" || fail 'cannot read honk reload result'
+			case "$(field status)" in
+				succeeded) echo ok; exit 0 ;;
+				failed) fail 'honk reload failed; generated config is saved on disk, check the honk log' ;;
+			esac
+			attempt=$((attempt + 1))
+			sleep 1
+		done
+		fail 'honk reload is still pending; check the honk log before retrying'
+	fi
+	echo ok
+	;;
+*) fail "usage: $0 {defaults|listener|install /tmp/honk-gen.*}" ;;
+esac
