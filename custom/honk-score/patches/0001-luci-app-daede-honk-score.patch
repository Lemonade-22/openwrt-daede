+function renderSettings() {
+    const m = new form.Map('honk');
+    const s = m.section(form.NamedSection, 'config', 'honk');
+    s.anonymous = true;
+    let o = s.option(form.Value, 'dashboard_username', _('Panel Username'));
+    o.placeholder = 'admin'; o.rmempty = false;
+    o = s.option(form.Value, 'dashboard_password', _('Panel Password'));
+    o.password = true; o.rmempty = false;
+    const status = E('span', {'class':'dd-editor-status'});
+    const save = E('button', {'class':'cbi-button cbi-button-apply'}, _('Save and initialize panel'));
+    save.addEventListener('click', async function() {
+        save.disabled = true;
+        try {
+            await m.save(); await uci.save(); await uci.apply();
+            const res = await fs.exec('/usr/share/luci-app-daede/honk-web.sh', ['prepare']);
+            if (res.code) throw new Error(res.stderr || res.stdout);
+            status.textContent = _('honk panel is ready.');
+        } catch (e) { status.textContent = e.message; }
+        finally { save.disabled = false; }
+    });
+    return m.render().then(function(node) {
+        return E('div', {'class':'dd-card'}, [
+            E('h4', {}, _('honk Panel')),
+            E('p', {}, _('These credentials initialize the panel on first use. For an existing account enter its current credentials. Nodes, groups, DNS and routing are managed in the WebUI. Use the shared subscription page to import subscriptions.')),
+            node, E('div', {'class':'dd-actions'}, [save, ' ', E('a', {'class':'cbi-button cbi-button-action','href':'/daede-honk/','target':'_blank','rel':'noopener'}, _('Open WebUI')), ' ', status])
+        ]);
+    });
+}
+return baseclass.extend({renderSettings:renderSettings});
