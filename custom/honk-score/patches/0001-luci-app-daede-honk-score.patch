--- /dev/null
+++ b/scripts/honk-score-selftest.py
@@ -0,0 +1,256 @@
+#!/usr/bin/env python3
+"""Exercise the LuCI policy choices and honk save/reload path in an isolated tree.
+
+Run on Linux with node, curl and ucode installed. No router files are modified.
+"""
+import http.server
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import threading
+import time
+import urllib.request
+
+REPO = Path(__file__).resolve().parents[1]
+SHARE = REPO / 'luci-app-daede/root/usr/share/luci-app-daede'
+
+
+def run(*args, env=None, ok=True):
+    result = subprocess.run(args, text=True, capture_output=True, env=env)
+    if ok and result.returncode:
+        raise AssertionError(result.stderr or result.stdout)
+    return result
+
+
+def check_form():
+    source = REPO / 'luci-app-daede/htdocs/luci-static/resources/view/daede/dae.js'
+    run('node', '-e', r'''
+const fs = require('fs'), assert = require('assert');
+const source = fs.readFileSync(process.argv[1], 'utf8');
+for (const name of ['dae', 'honk']) {
+  const sections = [];
+  function Map(config) {
+    assert.equal(config, name);
+    this.section = function(kind, type) {
+      const section = {type, fields: [], option(kind, key) {
+        const field = {key, values: [], value(v) {this.values.push(v)}};
+        this.fields.push(field); return field;
+      }};
+      sections.push(section); return section;
+    };
+    // Stop at rendering: the policy/validation contract is already constructed.
+    this.render = () => ({then() {}});
+  }
+  const module = new Function('baseclass','form','fs','uci','ui','backend','_','E', source)(
+    {extend: v => v}, {Map}, {}, {sections: () => []}, {}, {}, s => s, () => ({}));
+  module.renderDaeForms({backend:{name,uci:name},netDevs:[]});
+  const policy = sections.find(s => s.type === 'group').fields.find(f => f.key === 'policy');
+  assert.equal(policy.values.includes('score'), name === 'honk');
+  assert.equal(policy.values.includes('random'), name === 'dae');
+  assert.equal(policy.values.includes('min_last_delay'), name === 'honk');
+  const url = sections.find(s => s.type === 'subscription').fields.find(f => f.key === 'url');
+  assert.equal(url.validate('', 'https://example.com/sub'), true);
+  assert.equal(url.validate('', 'file://subscriptions/test.sub') === true, name === 'dae');
+}
+console.log('PASS: backend-specific policy choices and subscription validation');
+''', str(source))
+    print('PASS: LuCI policy choices, independent UCI packages, subscription validation')
+
+
+class API(http.server.BaseHTTPRequestHandler):
+    valid = True
+    reload_status = 'succeeded'
+    calls = []
+
+    def log_message(self, *args):
+        pass
+
+    def do_POST(self):
+        body = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
+        self.calls.append((self.path, body))
+        if self.path.endswith('/config/validate'):
+            assert body['mode'] == 'full'
+            assert 'policy: score' in body['sources'][0]['content']
+            result = {'valid': self.valid}
+        else:
+            assert self.path.endswith('/operations/reload')
+            result = {'operation_id': 'reload-1'}
+        self.reply(result)
+
+    def do_GET(self):
+        self.calls.append((self.path, None))
+        self.reply({'status': self.reload_status})
+
+    def reply(self, value):
+        self.send_response(200)
+        self.send_header('Content-Type', 'application/json')
+        self.end_headers()
+        self.wfile.write(json.dumps(value).encode())
+
+
+def check_generator():
+    with tempfile.TemporaryDirectory(prefix='honk-score-test-') as directory:
+        tree = Path(directory)
+        for name in ('etc/honk', 'tmp', 'bin', 'share', 'var/log/honk'):
+            (tree / name).mkdir(parents=True)
+        server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), API)
+        threading.Thread(target=server.serve_forever, daemon=True).start()
+        try:
+            state = {
+                'honk': {
+                    'config': {'.type': 'honk', 'store': 'file', 'config_file': str(tree / 'etc/honk/daede.dae'), 'wan_interface': '', 'lan_interface': ''},
+                    'test_node': {'.type': 'node', 'tag': 'test_node', 'link': 'socks5://127.0.0.1:1080#test_node'},
+                    'proxy': {'.type': 'group', 'name': 'proxy', 'policy': 'score'},
+                    'routing': {'.type': 'routing', 'cn_direct': '0', 'private_direct': '0'},
+                }
+            }
+            database = tree / 'uci.json'
+            database.write_text(json.dumps(state))
+            uci = tree / 'bin/uci'
+            uci.write_text('''#!/usr/bin/env python3
+import json, os, sys
+p=os.environ['MOCK_UCI_DATA']; d=json.load(open(p)); a=[x for x in sys.argv[1:] if x!='-q']; cmd=a.pop(0)
+if cmd=='commit': sys.exit(0)
+if cmd=='sections':
+ print(' '.join(k for k,v in d[a[0]].items() if v.get('.type')==a[1])); sys.exit(0)
+key,*value=a[0].split('=',1); parts=key.split('.')
+try:
+ if cmd=='get':
+  v=d
+  for k in parts: v=v[k]
+  print(' '.join(v) if isinstance(v,list) else v); sys.exit(0)
+ if cmd=='set':
+  d.setdefault(parts[0],{}).setdefault(parts[1],{})[parts[2]]=value[0]
+  json.dump(d,open(p,'w')); sys.exit(0)
+except KeyError: sys.exit(1)
+sys.exit(1)
+''')
+            uci.chmod(0o755)
+            functions = tree / 'functions.sh'
+            functions.write_text('''config_load() { CFG="$1"; }
+config_get() { local val; val="$(uci -q get "$CFG.$2.$3")" || val="${4:-}"; export "$1=$val"; }
+config_get_bool() { config_get "$@"; }
+config_foreach() { local sec; for sec in $(uci sections "$CFG" "$2"); do "$1" "$sec"; done; }
+config_list_foreach() { local val; for val in $(uci -q get "$CFG.$1.$2"); do "$3" "$val"; done; }
+''')
+            for name, content in (
+                ('pidof', '#!/bin/sh\n[ "$MOCK_RUNNING" = 1 ]\n'),
+                ('honk-core', '#!/bin/sh\nexit 0\n'),
+                ('honk-init', '#!/bin/sh\nexit 0\n'),
+            ):
+                path = tree / 'bin' / name
+                path.write_text(content)
+                path.chmod(0o755)
+
+            def isolated(text):
+                return (text.replace('/tmp/', str(tree / 'tmp') + '/')
+                        .replace('/lib/functions.sh', str(functions))
+                        .replace('/usr/share/luci-app-daede', str(tree / 'share'))
+                        .replace('/etc/init.d/honk', str(tree / 'bin/honk-init'))
+                        .replace('/usr/bin/honk-core', str(tree / 'bin/honk-core'))
+                        .replace('/etc/honk', str(tree / 'etc/honk'))
+                        .replace('/var/log/honk', str(tree / 'var/log/honk'))
+                        .replace('127.0.0.1:9528', '127.0.0.1:' + str(server.server_port)))
+
+            for name in ('gen-dae-config.sh', 'honk-config.sh'):
+                path = tree / 'share' / name
+                path.write_text(isolated((SHARE / name).read_text()))
+                path.chmod(0o755)
+            env = dict(os.environ, PATH=str(tree / 'bin') + ':' + os.environ['PATH'], MOCK_UCI_DATA=str(database), MOCK_RUNNING='0')
+            generator = str(tree / 'share/gen-dae-config.sh')
+            config = tree / 'etc/honk/daede.dae'
+            run('sh', generator, 'generate-honk', env=env)
+            text = config.read_text()
+            assert 'policy: score' in text and "filter: name(regex: '.*')" in text
+            assert '127.0.0.1:' + str(server.server_port) in text
+            assert config.stat().st_mode & 0o777 == 0o600
+            assert not API.calls, 'stopped saves must not claim runtime validation'
+            print('PASS: score config generation, all-node filter, private config, stopped save')
+
+            env['MOCK_RUNNING'] = '1'
+            API.calls.clear()
+            run('sh', generator, 'generate-honk', env=env)
+            assert [p for p, _ in API.calls] == ['/api/v1/config/validate', '/api/v1/operations/reload', '/api/v1/operations/reload-1']
+            print('PASS: full validation before save, reload acknowledgement')
+
+            config.write_text('# keep active file\n')
+            API.valid = False
+            API.calls.clear()
+            result = run('sh', generator, 'generate-honk', env=env, ok=False)
+            assert result.returncode and config.read_text() == '# keep active file\n'
+            assert len(API.calls) == 1
+            print('PASS: rejected candidate preserves active file and does not reload')
+
+            API.valid = True
+            API.reload_status = 'failed'
+            result = run('sh', generator, 'generate-honk', env=env, ok=False)
+            assert result.returncode and 'reload failed' in result.stderr
+            print('PASS: failed runtime reload cannot report success')
+
+            state['honk']['proxy']['policy'] = 'random'
+            database.write_text(json.dumps(state))
+            assert run('sh', generator, 'generate-honk', env=env, ok=False).returncode
+            state['honk']['proxy']['policy'] = 'score'
+            state['honk']['airport'] = {'.type': 'subscription', 'url': 'file://subscriptions/airport.sub'}
+            database.write_text(json.dumps(state))
+            assert run('sh', generator, 'generate-honk', env=env, ok=False).returncode
+            print('PASS: unsupported policies and file subscriptions are rejected')
+
+            # Optional integration against a real upstream release. --mock-ebpf
+            # avoids attaching hooks or changing the host's routing interfaces.
+            core = os.environ.get('HONK_CORE_BINARY')
+            if core:
+                server.shutdown()
+                server.server_close()
+                state['honk'].pop('airport')
+                database.write_text(json.dumps(state))
+                env['MOCK_RUNNING'] = '0'
+                run('sh', generator, 'generate-honk', env=env)
+                geo = tree / 'geo'
+                geo.mkdir()
+                # Minimal protobuf GeoSiteList, CN -> domain example.cn.
