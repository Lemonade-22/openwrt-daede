index 0000000000000000000000000000000000000000..f42313dd533c36e9c1a4a3e9223ffbf3e1e998bb
--- /dev/null
+++ b/luci-app-daede/root/usr/share/luci-app-daede/honk-web.sh
@@ -0,0 +1,31 @@
+#!/bin/sh
+# Account credentials are read from private UCI, never passed on command lines.
+set -eu
+umask 077
+tmp=$(mktemp -d /tmp/daede-honk-account.XXXXXX)
+trap 'rm -rf "$tmp"' EXIT
+api=http://127.0.0.1:9528
+fail() { echo "$*" >&2; exit 1; }
+case "${1:-}" in
+prepare)
+    [ "$(uci -q get honk.config.store || echo file)" = file ] || fail 'Database storage is active; export it before switching to file management.'
+    config=$(uci -q get honk.config.config_file || echo /etc/honk/config.dae)
+    [ -f "$config" ] || fail 'Install honk first; its configuration file is missing.'
+    pidof dae daed >/dev/null 2>&1 && fail 'Stop dae/daed before starting honk.'
+    # A previous version stored the static secret in this managed main file.
+    # Replace only its native listener; retain every proxy/routing section.
+    ucode /usr/share/luci-app-daede/honk-web-setup.uc "$config"
+    /etc/init.d/honk restart
+    tries=0
+    until curl -fsS --noproxy '*' --max-time 2 "$api/api" > "$tmp/discovery"; do
+        tries=$((tries+1)); [ "$tries" -lt 30 ] || fail 'honk did not start; check its log.'
+        sleep 1
+    done
+    ucode -e 'let uci=require("uci").cursor(); uci.load("honk"); let u=uci.get("honk","config","dashboard_username"), p=uci.get("honk","config","dashboard_password"); if (!u || !p) die("Set the honk dashboard username and password first\n"); print({username:u,password:p});' > "$tmp/login"
+    action=$(ucode -e 'let fs=require("fs"); print(json(fs.readfile(ARGV[0])).auth.setup_required ? "setup" : "login");' "$tmp/discovery")
+    code=$(curl -sS --noproxy '*' --max-time 30 -o "$tmp/session" -w '%{http_code}' -H 'Content-Type: application/json' --data-binary "@$tmp/login" "$api/api/v1/auth/$action")
+    [ "$code" = 200 ] || [ "$code" = 201 ] || fail 'honk account initialization/login failed. For an existing account use its current password; saving credentials does not reset it.'
+    echo 'honk WebUI is ready. Use the saved account to sign in.'
+    ;;
+*) fail 'usage: honk-web.sh prepare' ;;
+esac
