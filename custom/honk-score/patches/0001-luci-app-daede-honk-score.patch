new file mode 100644
index 0000000000000000000000000000000000000000..2e8ef545975aa355fd6e0e40b1870003f5b91397
--- /dev/null
+++ b/luci-app-daede/root/www/cgi-bin/daede-honk
@@ -0,0 +1,38 @@
+#!/usr/bin/ucode
+// Same-origin relay. honk checks the caller's own session on every request.
+// Account setup is intentionally local-only through the LuCI privileged helper.
+import * as fs from 'fs';
+function reply(status, body) {
+    print(`Status: ${status}\r\nContent-Type: application/json\r\nCache-Control: no-store\r\n\r\n${body}`);
+    exit(0);
+}
+let query = getenv('QUERY_STRING') || '';
+let raw = match(query, /^path=([^&]+)$/);
+let path = raw ? replace(raw[1], /%([0-9a-fA-F]{2})/g, m => chr(int(substr(m, 1), 16))) : '';
+if (!match(path, /^\/api\/v1\/(version|capabilities|runtime|nodes|providers|groups|config|operations|probes|auth\/login|auth\/logout)([\/?][A-Za-z0-9_.~%?=&\/-]*)?$/))
+    reply('400 Bad Request', '{"message":"Unsupported native API path"}');
+let method = getenv('REQUEST_METHOD');
+if (index(['GET','POST','PUT','PATCH','DELETE'], method) < 0) reply('405 Method Not Allowed', '{}');
+let auth = getenv('HTTP_AUTHORIZATION') || '';
+let etag = getenv('HTTP_IF_MATCH') || '';
+if (match(auth + etag, /[\r\n]/)) reply('400 Bad Request', '{}');
+let length = int(getenv('CONTENT_LENGTH') || '0');
+if (length < 0 || length > 4194304) reply('413 Payload Too Large', '{}');
+let temp = fs.mkdtemp('/tmp/daede-honk-relay.XXXXXX');
+if (!temp) reply('500 Internal Server Error', '{}');
+let headers = fs.open(temp + '/headers', 'w', 0600);
+headers.write('Content-Type: application/json\n');
+if (auth) headers.write('Authorization: ' + auth + '\n');
+if (etag) headers.write('If-Match: ' + etag + '\n');
+headers.close();
+let body = fs.open(temp + '/body', 'w', 0600);
+body.write(length ? fs.stdin.read(length) : ''); body.close();
+// Every shell-interpolated value is fixed, enum-checked, or restricted above.
+let cmd = sprintf("curl -sS --noproxy '*' --connect-timeout 3 --max-time 120 -X %s -H @%s/headers %s -o %s/response -w '%%{http_code}' 'http://127.0.0.1:9528%s'", method, temp, length ? '--data-binary @' + temp + '/body' : '', temp, path);
+let pipe = fs.popen(cmd, 'r');
+let status = pipe ? trim(pipe.read('all')) : '502';
+let rc = pipe ? pipe.close() : 1;
+let result = fs.readfile(temp + '/response') || '{}';
+for (let file in ['headers','body','response']) fs.unlink(temp + '/' + file);
+fs.rmdir(temp);
+reply(rc == 0 && match(status, /^[1-5][0-9][0-9]$/) ? status : '502 Bad Gateway', result);
diff --git a/scripts/honk-score-selftest.py b/scripts/honk-score-selftest.py
new file mode 100644
index 0000000000000000000000000000000000000000..c6ce6e815c60ffd252c22ddbf29c499ef846c952
--- /dev/null
+++ b/scripts/honk-score-selftest.py
@@ -0,0 +1,256 @@
+#!/usr/bin/env python3
+"""Exercise the LuCI policy choices and honk save/reload path in an isolated tree.
+
+Run on Linux with node, curl and ucode installed. No router files are modified.
+"""
+import http.server
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import threading
+import time
+import urllib.request
+
+REPO = Path(__file__).resolve().parents[1]
+SHARE = REPO / 'luci-app-daede/root/usr/share/luci-app-daede'
+
+
+def run(*args, env=None, ok=True):
+    result = subprocess.run(args, text=True, capture_output=True, env=env)
+    if ok and result.returncode:
+        raise AssertionError(result.stderr or result.stdout)
+    return result
+
+
+def check_form():
+    source = REPO / 'luci-app-daede/htdocs/luci-static/resources/view/daede/dae.js'
+    run('node', '-e', r'''
+const fs = require('fs'), assert = require('assert');
+const source = fs.readFileSync(process.argv[1], 'utf8');
+for (const name of ['dae', 'honk']) {
+  const sections = [];
+  function Map(config) {
+    assert.equal(config, name);
+    this.section = function(kind, type) {
+      const section = {type, fields: [], option(kind, key) {
+        const field = {key, values: [], value(v) {this.values.push(v)}};
+        this.fields.push(field); return field;
+      }};
+      sections.push(section); return section;
+    };
+    // Stop at rendering: the policy/validation contract is already constructed.
+    this.render = () => ({then() {}});
+  }
+  const module = new Function('baseclass','form','fs','uci','ui','backend','_','E', source)(
+    {extend: v => v}, {Map}, {}, {sections: () => []}, {}, {}, s => s, () => ({}));
+  module.renderDaeForms({backend:{name,uci:name},netDevs:[]});
+  const policy = sections.find(s => s.type === 'group').fields.find(f => f.key === 'policy');
+  assert.equal(policy.values.includes('score'), name === 'honk');
+  assert.equal(policy.values.includes('random'), name === 'dae');
+  assert.equal(policy.values.includes('min_last_delay'), name === 'honk');
+  const url = sections.find(s => s.type === 'subscription').fields.find(f => f.key === 'url');
+  assert.equal(url.validate('', 'https://example.com/sub'), true);
+  assert.equal(url.validate('', 'file://subscriptions/test.sub') === true, name === 'dae');
+}
